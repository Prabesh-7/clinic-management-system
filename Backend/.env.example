APP_NAME=Clinic Management System API
APP_ENV=development
DEBUG=true
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
INVITE_TOKEN_HOURS=72
INVITE_ACCEPT_URL=http://localhost:3000/set-password

# Optional SMTP delivery for account invite emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=Clinic Management System
EMAIL_FROM_EMAIL=
CONSOLE_EMAIL=false
RESEND_API_KEY=

# PostgreSQL connection used by SQLAlchemy through asyncpg.
# Replace username, password, host, port, and database if needed.
DATABASE_URL=postgresql+asyncpg://postgres:Helloworld@postgres:5432/dental_cms
